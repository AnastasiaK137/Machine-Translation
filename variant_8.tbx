<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif SYSTEM "TBXcoreStructV02.dtd">
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <titleStmt>
        <title>Glossary EN-RU: Атомная энергетика и реакторные технологии</title>
      </titleStmt>
      <sourceDesc>
        <p>Lab 01, variant 8, generated automatically</p>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <p type="XCSURI">TBXXCSV02.xcs</p>
    </encodingDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="tid-001">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>nuclear</term>
            <termNote type="partOfSpeech">adjective</termNote>
            <descrip type="definition">Relating to a nucleus; relating to or using energy released in nuclear fission or fusion.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ядерный</term>
              <termNote type="partOfSpeech">adjective</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-002">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>spent fuel</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Nuclear fuel that has been irradiated in a reactor and removed after use.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>отработавшее топливо</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-003">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>nuclear material</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Plutonium except that with isotopic concentration exceeding 80% in 238Pu; 233U; uranium enriched in the isotope 235 or 233; uranium containing the mixture of isotopes as occurring in nature other than in the form of ore or ore residue; any material containing one or more of the foregoing. </descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ядерный материал</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-004">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>high enriched uranium</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Uranium containing 20% or more of the isotope 235U. HEU is considered a special fissionable material and a direct use material.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>высокообогащенный уран</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-005">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>nuclear fuel</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Fissionable nuclear material in the form of fabricated elements for loading into the reactor core of a civil nuclear power plant or research reactor.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ядерное топливо</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-006">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>low enriched uranium</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Enriched uranium containing less than 20% of the isotope 235U. LEU is considered a special fissionable material and an indirect use material.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>низкообогащенный уран</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-007">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>dry storage</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Storage in a gaseous medium, such as air or an inert gas.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>сухое хранение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-008">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>disposal facility</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An engineered facility where waste is emplaced for disposal</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>пункт захоронения</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-009">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>storage</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The holding of radioactive sources, radioactive material, spent fuel or radioactive waste in a facility that provides for their/its containment, with the intention of retrieval.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>хранение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-010">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>reprocess</term>
            <termNote type="partOfSpeech">verb</termNote>
            <descrip type="definition">A process or operation, the purpose of which is to extract radioactive isotopes from spent fuel for further use.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>перерабатывать</term>
              <termNote type="partOfSpeech">verb</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-011">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>exempt waste</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Waste from which regulatory control is removed in accordance with exemption principles.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>изъятые отходы </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-012">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>advection</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The movement of a substance or the transfer of heat by the motion of the gas (usually air) or liquid (usually water) in which it is present.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>адвекция</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-013">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>activation</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The process of inducing radioactivity in matter by irradiation of that matter.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>активация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-014">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>active component</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A component whose functioning depends on an external input such as actuation, mechanical movement or supply of power.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>активный элемент </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-015">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>bioassay</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Any procedure used to determine the nature, activity, location or retention of radionuclides in the body by direct (in vivo) measurement or by in vitro analysis of material excreted or otherwise removed from the body.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>анализ биопроб</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-016">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>becquerel </term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The SI unit of activity, equal to one (transformation) per second.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>беккерель</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-017">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>near field</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The excavated area of a disposal facility near or in contact with the waste packages, including filling or sealing materials, and those parts of the host medium/rock whose characteristics have been or could be altered by the disposal facility or its contents.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ближняя зона</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-018">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>failure mode</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The manner or state in which a structure, system or component fails.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>вид отказа</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-019">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>far field</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The geosphere outside a disposal facility, comprisin g the surrounding geological strata, at a distance from the disposal facility such that, for modelling purposes, the disposal facility may be considered a single entity and the effects of individual waste packages are not distinguished.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>дальняя зона</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-020">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>radiopharmacist</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A health professional, with specialist education and training in radiopharmacy, who is competent to prepare and dispense radiopharmaceuticals used for the purposes of medical diagnosis and radionuclide therapy.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>радиофармацевт</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-021">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>fission product</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A radionuclide produced by nuclear fission.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>продукт деления</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-022">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>neutron scattering</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An analysis technique for understanding the structure and behaviour of solids and condensed matter.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>нейтронное рассеяние</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-023">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>frequency of exceedance</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The frequency at which a specified level of seismic hazard will be exceeded at a site or in a region within a specified time interval. </descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>частота превышения</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-024">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>geological fault</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A planar or gently curved fracture surface or zone of the Earth across which there has been relative displacement.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>геологический разлом</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-025">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>helper in an emergency</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Member of the public who willingly and voluntarily helps in the response to a nuclear or radiological emergency.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>лицо, оказывающее помощь в аварийной ситуации </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-026">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>igneous rock</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Rock that has formed from magma.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>магматическая горная порода</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-027">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>initiating event</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An identified event that leads to anticipated operational occurrences or accident conditions.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>исходное событие</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-028">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>intake</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The act or process of taking radionuclides into the body by inhalation or ingestion or through the skin.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>поступление </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-029">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>acute intake</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An intake occurring within a time period short enough that it can be treated as instantaneous for the purposes of assessing the resulting committed dose.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>острое поступление</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-030">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>potential exposure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Prospectively considered exposure that is not expected to be delivered with certainty but that may result from an anticipated operational occurrence or accident at a source or owing to an event or sequence of events of a probabilistic nature, including equipment failures and operating errors.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>потенциальное облучение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-031">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>low specific activity material</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Radioactive material that by its nature has a limited specific activity, or radioactive material for which limits of estimated average specific activity apply. </descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>материал с низкой удельной активностью</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-032">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>medical physicist</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A health professional with specialist education and training in the concepts and techniques of applying physics in medicine and competent to practise independently in one or more of the subfields (specialties) of medical physics.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>медицинский физик</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-033">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>minimum significant activity</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The radioactivity which, if present in a sample, produces a counting rate that can be reliably distinguished from background with a certain level of confidence.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>минимальная значимая активность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-034">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>minimum detectable activity</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The radioactivity which, if present in a sample, produces a counting rate that will be detected (i.e. considered to be above background) with a certain level of confidence.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>минимальная обнаруживаемая активность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-035">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>recycling</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The process of converting waste materials into new products.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>рециклирование</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-036">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>risk monitor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A plant specific real time analysis tool used to determine the instantaneous risk based on the actual status of the systems and components. </descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>монитор риска</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-037">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>monitoring</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The measurement of dose, dose rate or activity for reasons relating to the assessment or control of exposure to radiation or exposure due to radioactive substances, and the interpretation of the results.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>мониторинг</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-038">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>unirradiated thorium</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Thorium containing not more than 10–7 g of 233U per gram of 232Th.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>необлученный торий </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-039">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>safety case</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A collection of arguments and evidence in support of the safety of a facility or activity.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обоснование безопасности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-040">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>volcano generated missile</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A pyroclastic particle, often of large size, that is forcefully ejected, follows a high angle trajectory from the volcanic vent to the surface as a result of explosive activity at the vent and falls under gravity.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>образуемые вулканом обломки</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-041">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>immobilization</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Conversion of waste into a waste form by solidification, embedding or encapsulation.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>иммобилизация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-042">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>conditioning</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Those operations that produce a waste package suitable for handling, transport, storage and/or disposal.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>кондиционирование</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-043">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>treatment</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Operations intended to benefit safety and/or economy by changing the characteristics of the waste. </descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обработка </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-044">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>volume reduction</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A treatment method that decreases the physical volume of a waste.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>сокращение объема</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-045">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>area survey</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An early stage of the siting process for a disposal facility, during which a broad region is examined to eliminate unsuitable areas and to identify other areas which may contain suitable sites.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обследование территории</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-046">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>operator</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Any person or organization applying for authorization or authorized and/or responsible for safety when undertaking activities or in relation to any nuclear facilities or sources of ionizing radiation.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>оператор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-047">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>operational quantities</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Quantities used in practical applications for monitoring and investigations that involve external exposure.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>операционные величины</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-048">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>clearance</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Removal of regulatory control by the regulatory body from radioactive material or radioactive objects within notified or authorized facilities and activities.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>освобождение от контроля</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-049">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>licensing basis</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A set of regulatory requirements applicable to a nuclear installation.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>основа лицензирования</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-050">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>shutdown</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The cessation of operation of a facility.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>остановка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-051">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>calibration</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A measurement of, or adjustment to, an instrument, component or system to ensure that its accuracy or response is acceptable.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>калибровка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-052">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>channel</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An arrangement of interconnected components within a system that initiates a single output.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>канал</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-053">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>qualification</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Process of determining whether a system or component is suitable for operational use.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>квалификация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-054">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>safety class</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">For nuclear power plants, the classes into which systems and components and other items of equipment are assigned on the basis of their functions and their safety significance.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>класс безопасности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-055">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>emergency class</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A set of conditions that warrant a similar immediate emergency response.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>класс аварийной ситуации</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-056">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>short lived waste</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Radioactive waste that does not contain significant levels of radionuclides with a half-life greater than 30 years.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>короткоживущие отходы</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-057">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>low level waste</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Radioactive waste that is above clearance levels, but with limited amounts of long lived radionuclides.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>низкоактивные отходы</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-058">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>end point</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The final stage of a process, especially the point at which an effect is observed.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>конечная точка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-059">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>eruption cloud</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A cloud of tephra and gases that forms above a volcanic vent during explosive volcanic eruptions.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>облако извержения </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-060">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>end state</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The state of radioactive waste in the final stage of radioactive waste management, in which the waste is passively safe and does not depend on institutional control.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>конечное состояние</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-061">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>irradiation installation</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A structure or an installation that houses a particle accelerator, X ray apparatus or large radioactive source and that can produce high radiation fields.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>облучательная установка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-062">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>exposure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The state or condition of being subject to irradiation.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>облучение </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-063">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>cladding</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An external layer of material applied directly to another material to provide protection in chemically reactive conditions.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>оболочка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-064">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>nuclear installation</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Any nuclear facility subject to authorization that is part of the nuclear fuel cycle, except facilities for the mining or processing of uranium ores or thorium ores and disposal facilities for radioactive waste.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ядерная установка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-065">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>dose equivalent</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The product of the absorbed dose at a point in the tissue or organ and the appropriate quality factor for the type of radiation giving rise to the dose.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>эквивалент дозы</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-066">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>evacuation</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The rapid, temporary removal of people from an area to avoid or reduce short term radiation exposure in a nuclear or radiological emergency.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>эвакуация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-067">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>waste form</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Waste in its physical and chemical form after treatment and/or conditioning (resulting in a solid product) prior to packaging. </descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>форма отходов</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-068">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>nuclear security</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The prevention and detection of, and response to, criminal or intentional unauthorized acts involving nuclear material, other radioactive material, associated facilities or associated activities.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>физическая ядерная безопасность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-069">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>emergency response phase</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The period of time from the detection of conditions warranting an emergency response until the completion of all the emergency response actions taken in anticipation of or in response to the radiological conditions expected in the first few months of the emergency.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>фаза аварийного реагирования</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-070">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>facilities and activities</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A general term encompassing nuclear facilities, uses of all sources of ionizing radiation, all radioactive waste management activities, transport of radioactive material and any other practice or circumstances in which people may be subject to exposure to radiation from naturally occurring or artificial sources.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>установки и деятельность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-071">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>passive safety</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The achievement of safety through the use of components and systems that do not require external input such as actuation, mechanical movement, or supply of power to operate.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>пассивная безопасность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-072">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>core melt</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An event or sequence of events that result in the melting of part of the fuel in the reactor core.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>расплавление активной зоны</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-073">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>critical mass</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The minimum amount of fissile material needed to sustain a nuclear chain reaction, depending on geometry, enrichment, and the presence of moderator and reflector.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>критическая масса</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-074">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>decay heat</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The heat generated by the radioactive decay of fission products after a reactor has been shut down.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>остаточное тепловыделение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-075">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>decommissioning</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Taking a facility permanently out of service and placing and maintaining it in a safe state.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>вывод из эксплуатации</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-076">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>depleted uranium</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Uranium having a percentage of uranium-235 smaller than the 0.7% found in natural uranium, typically obtained from spent fuel or enrichment tails.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обедненный уран</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-077">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>design basis accident</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Accident conditions against which a nuclear facility is designed according to established design criteria, and for which the damage to the fuel and the release of radioactive material are kept within authorized limits.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>проектная авария</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-078">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>fuel assembly</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A form of nuclear fuel consisting of bundles of fuel elements, fuel channels, distancing grids, and end fittings.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>тепловыделяющая сборка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-079">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>half-life</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The time taken for one half the atoms of a radioactive substance to disintegrate.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>период полураспада</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-080">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>mixed oxide fuel</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Nuclear fuel that contains a mixture of plutonium and uranium oxides, typically used to recycle plutonium from spent fuel.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>смешанное оксидное топливо</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-081">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>moderator</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A material used in a thermal reactor to slow down fast neutrons, increasing the probability of fission in uranium-235.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>замедлитель</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-082">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>reactivity</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A measure of the departure of a reactor from criticality, expressed as the fractional change in neutron population per generation.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>реактивность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-083">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>small modular reactor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A nuclear reactor designed to generate electric power typically up to 300 MW, with components and systems that can be factory-fabricated and transported as modules for installation on site.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>малый модульный реактор</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-084">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>transuranic elements</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Artificial elements with atomic numbers higher than uranium (92), typically produced by neutron bombardment of uranium in a reactor.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>трансурановые элементы</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-085">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>zero-power reactor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An experimental reactor operated at such low power levels that a coolant is not needed and little radioactivity is produced.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>реактор нулевой мощности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-086">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>sheltering</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The short term use of a structure for protection from an airborne plume and/or deposited radioactive material.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>укрытие</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-087">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>tissue equivalent material</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Material designed to have, when irradiated, interaction properties similar to those of soft tissue.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>тканеэквивалентный материал</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-088">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>radiological assessor</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A person or team who in the event of a nuclear or radiological emergency assists the operator or off-site response organizations by performing radiological surveys, performing dose assessments, controlling contamination, ensuring the radiation protection of emergency workers and formulating recommendations on protective actions and other response actions.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>специалист по оценке радиологической обстановки</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-089">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>sorption</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The interaction of an atom, molecule or particle with the solid surface at a solid–solution or a solid–gas interface.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>сорбция</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-090">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>system code</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A computational model that is capable of simulating the transient performance of a complex system such as a nuclear power plant.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>системный код</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-091">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>discharge</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Planned and controlled release of (usually gaseous or liquid) radioactive substances to the environment.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>сброс</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-092">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>representative person</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An individual receiving a dose that is representative of the doses to the more highly exposed individuals in the population.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>репрезентативное лицо</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-093">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>dispersal</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The spreading of radioactive material in the environment.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>рассеяние</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-094">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>radioactive material</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Material designated in national law or by a regulatory body as being subject to regulatory control because of its radioactivity.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>радиоактивный материал</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-095">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>radiation</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The emission and propagation of energy in the form of waves or particles.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>радиация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-096">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>exposure pathway</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A route by which radiation or radionuclides can reach humans and cause exposure.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>путь облучения </term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-097">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>natural uranium</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Uranium as found in nature, containing approximately 0.7% uranium-235, 99.3% uranium-238 and a trace amount of uranium-234.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>природный уран</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-098">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>absorbed fraction</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The fraction of energy emitted as a specified radiation type in a specified source region that is absorbed in a specified target tissue.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>поглощенная фракция</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-099">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>uptake</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A general term for the processes by which radionuclides enter one part of a biological system from another.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>поглощение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-100">
        <descrip type="subjectField">Атомная энергетика и реакторные технологии</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>prime mover</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A component that converts energy into action when commanded by an actuation device.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>первичный двигатель</term>
